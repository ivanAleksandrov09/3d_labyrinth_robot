	(text "*OPM - One Pulse Mode where we can use a single CPU \ninstruction to tell the timer to physically turn itself off \non every number of cycles instead of wasting CPU calls every\ntime to turn it on/off.\nHINT: set the update generation bit TIMx_EGR.UG = 1"
		(exclude_from_sim no)
		(at 38.862 183.896 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "3d808552-f7e9-432f-b3cf-00bf01ba78f9")
	)
